{
  "name": "@appee/console",
  "private": true,
  "version": "0.1.0",
  "description": "appee web console — sign up, build, install flow (Next.js 15).",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force && pnpm db:apply-rls",
    "db:apply-rls": "node --env-file=.env.local scripts/apply-rls.mjs",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "^15.4.0",
    "postgres": "^3.4.5",
    "qrcode.react": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^17.4.0",
    "tar": "^7.5.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
